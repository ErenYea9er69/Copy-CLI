{
  "name": "copyshed",
  "version": "0.1.0",
  "description": "Deterministic post-processor that finds UI copy in your codebase and rewrites it to match a defined brand voice, audience, and tone, with safe AST-based preview and apply.",
  "type": "module",
  "bin": {
    "copyshed": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "copyshed.config.example.json"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --target node18 --platform node --clean --out-dir dist --shims",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.25.0",
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "fast-glob": "^3.3.2",
    "magic-string": "^0.30.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.9",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
